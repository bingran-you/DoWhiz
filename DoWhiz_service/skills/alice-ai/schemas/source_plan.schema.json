{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/source_plan.schema.json",
  "title": "Alice Source Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_plan_id",
    "request_id",
    "subject_resolution_id",
    "jurisdiction_context_id",
    "coverage_assessment_id",
    "plan_status",
    "request_mode",
    "active_use_cases",
    "required_capabilities",
    "planned_source_groups",
    "deferred_steps",
    "blocked_steps",
    "missing_capabilities",
    "notes",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.source_plan.v1"
    },
    "source_plan_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "jurisdiction_context_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "coverage_assessment_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "plan_status": {
      "$ref": "#/$defs/plan_status"
    },
    "request_mode": {
      "$ref": "#/$defs/request_mode"
    },
    "active_use_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/high_level_use_case"
      },
      "uniqueItems": true
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planning_capability"
      },
      "uniqueItems": true
    },
    "planned_source_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planned_source_group"
      }
    },
    "deferred_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan_step"
      }
    },
    "blocked_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan_step"
      }
    },
    "missing_capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planning_capability"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "recommendation",
        "deep_research",
        "batch_compare",
        "follow_up"
      ]
    },
    "high_level_use_case": {
      "type": "string",
      "enum": [
        "energy",
        "agriculture",
        "residential_light_development",
        "industrial_storage_commercial",
        "recreational_rural_hold"
      ]
    },
    "planning_capability": {
      "type": "string",
      "enum": [
        "parcel_identity",
        "parcel_geometry",
        "zoning",
        "planning_docs",
        "tax_roll",
        "environmental_baseline",
        "water_signals",
        "utilities",
        "transmission",
        "market_context"
      ]
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "ready",
        "partially_blocked",
        "blocked"
      ]
    },
    "group_status": {
      "type": "string",
      "enum": [
        "ready",
        "deferred",
        "blocked"
      ]
    },
    "authority_level": {
      "type": "string",
      "enum": [
        "official_local_or_county",
        "official_state",
        "official_federal",
        "platform",
        "mixed"
      ]
    },
    "step_blocker_type": {
      "type": "string",
      "enum": [
        "jurisdiction_unresolved",
        "county_required",
        "subject_resolution_required",
        "local_source_gap",
        "recommendation_flow_deferred",
        "mixed_batch_jurisdiction",
        "city_specific_context_missing"
      ]
    },
    "planned_source_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "subject_ids",
        "source_ids",
        "source_selection_rationale",
        "priority_order",
        "authority_level",
        "execution_preconditions",
        "fallback_if_missing",
        "group_status",
        "notes"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/planning_capability"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_selection_rationale": {
          "type": "string",
          "minLength": 1
        },
        "priority_order": {
          "type": "integer",
          "minimum": 1
        },
        "authority_level": {
          "$ref": "#/$defs/authority_level"
        },
        "execution_preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fallback_if_missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "group_status": {
          "$ref": "#/$defs/group_status"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "subject_ids",
        "blocker_type",
        "reason",
        "dependency"
      ],
      "properties": {
        "capability": {
          "$ref": "#/$defs/planning_capability"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "blocker_type": {
          "$ref": "#/$defs/step_blocker_type"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "dependency": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
