{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/parcel_candidates.schema.json",
  "title": "Alice Parcel Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parcel_candidates_id",
    "request_id",
    "subject_resolution_id",
    "jurisdiction_context_id",
    "source_fetch_log_id",
    "generated_at",
    "candidate_set_status",
    "candidate_strategy",
    "primary_candidate_id",
    "candidate_count",
    "candidates",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.parcel_candidates.v1"
    },
    "parcel_candidates_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "jurisdiction_context_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "source_fetch_log_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate_set_status": {
      "$ref": "#/$defs/candidate_set_status"
    },
    "candidate_strategy": {
      "$ref": "#/$defs/candidate_strategy"
    },
    "primary_candidate_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/candidate_id_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "bounded_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_id_string": {
      "type": "string",
      "pattern": "^[a-z0-9._:-]+$"
    },
    "candidate_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate_id_string"
      },
      "uniqueItems": true
    },
    "item_id_string": {
      "type": "string",
      "pattern": "^[a-z0-9_:-]+$"
    },
    "evidence_scope": {
      "type": "string",
      "enum": [
        "parcel_confirmed",
        "parcel_candidate",
        "listing_derived",
        "county_level",
        "geography_only",
        "inferred",
        "unresolved"
      ]
    },
    "candidate_set_status": {
      "type": "string",
      "enum": [
        "single_strong_candidate",
        "single_weak_candidate",
        "multiple_competing_candidates",
        "parcel_group_case",
        "no_viable_candidate"
      ]
    },
    "candidate_strategy": {
      "type": "string",
      "enum": [
        "apn_corroboration",
        "address_apn_merge",
        "listing_only",
        "local_record_corroboration",
        "follow_up_inherited",
        "clue_cluster",
        "none"
      ]
    },
    "candidate_strength": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak",
        "none"
      ]
    },
    "confirmation_level": {
      "type": "string",
      "enum": [
        "parcel_confirmed",
        "candidate_corroborated",
        "candidate_unconfirmed",
        "listing_hint_only",
        "geography_only",
        "unresolved"
      ]
    },
    "confirmation_basis": {
      "type": "string",
      "enum": [
        "text_corroborated",
        "local_record_corroborated",
        "geometry_confirmed",
        "unknown"
      ]
    },
    "geometry_status": {
      "type": "string",
      "enum": [
        "boundary_confirmed",
        "map_page_hint",
        "point_only",
        "none"
      ]
    },
    "clue_type": {
      "type": "string",
      "enum": [
        "apn",
        "county_parcel_id",
        "address",
        "acreage",
        "owner_name",
        "legal_description",
        "county_name",
        "state_name",
        "coordinates",
        "zoning_reference",
        "parcel_group_hint",
        "listing_identifier",
        "page_context",
        "other"
      ]
    },
    "address_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_address",
        "country_code"
      ],
      "properties": {
        "full_address": {
          "type": "string",
          "minLength": 1
        },
        "street_line1": {
          "$ref": "#/$defs/nullable_string"
        },
        "street_line2": {
          "$ref": "#/$defs/nullable_string"
        },
        "city": {
          "$ref": "#/$defs/nullable_string"
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "postal_code": {
          "$ref": "#/$defs/nullable_string"
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "acreage_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_acres",
        "status",
        "confidence",
        "evidence_scope",
        "source_id",
        "source_item_id",
        "citation_ids",
        "notes"
      ],
      "properties": {
        "value_acres": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "estimated",
            "conflicting",
            "missing",
            "not_applicable"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "evidence_scope": {
          "$ref": "#/$defs/evidence_scope"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/item_id_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_clue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clue_id",
        "clue_type",
        "raw_value",
        "normalized_value",
        "source_id",
        "source_item_id",
        "evidence_scope",
        "confidence",
        "weight",
        "citation_ids",
        "notes"
      ],
      "properties": {
        "clue_id": {
          "$ref": "#/$defs/candidate_id_string"
        },
        "clue_type": {
          "$ref": "#/$defs/clue_type"
        },
        "raw_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "normalized_value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/item_id_string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_scope": {
          "$ref": "#/$defs/evidence_scope"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "weight": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "citation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "county_fips",
        "state_fips",
        "apn_raw",
        "apn_normalized",
        "apn_variants",
        "parcel_address",
        "acreage_claims",
        "source_clues",
        "supporting_source_ids",
        "contradicting_source_ids",
        "candidate_strength",
        "confirmation_level",
        "confirmation_basis",
        "geometry_status",
        "notes"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/candidate_id_string"
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "apn_raw": {
          "$ref": "#/$defs/nullable_string"
        },
        "apn_normalized": {
          "$ref": "#/$defs/nullable_string"
        },
        "apn_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parcel_address": {
          "anyOf": [
            {
              "$ref": "#/$defs/address_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "acreage_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acreage_claim"
          }
        },
        "source_clues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_clue"
          }
        },
        "supporting_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contradicting_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidate_strength": {
          "$ref": "#/$defs/candidate_strength"
        },
        "confirmation_level": {
          "$ref": "#/$defs/confirmation_level"
        },
        "confirmation_basis": {
          "$ref": "#/$defs/confirmation_basis"
        },
        "geometry_status": {
          "$ref": "#/$defs/geometry_status"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
