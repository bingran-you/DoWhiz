{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/alice_session_state.schema.json",
  "title": "Alice Session State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thread_id",
    "updated_at",
    "active_request_mode",
    "active_resolution_ref",
    "active_subject_set_kind",
    "active_subjects",
    "thesis_snapshot",
    "artifact_refs",
    "unresolved_questions",
    "user_confirmed_assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.session_state.v1"
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "active_request_mode": {
      "$ref": "#/$defs/request_mode"
    },
    "active_resolution_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "active_subject_set_kind": {
      "$ref": "#/$defs/subject_kind"
    },
    "active_subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/active_subject_summary"
      }
    },
    "thesis_snapshot": {
      "$ref": "#/$defs/thesis_snapshot"
    },
    "artifact_refs": {
      "$ref": "#/$defs/artifact_refs"
    },
    "previous_resolution_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      },
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_confirmed_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "request_mode": {
      "type": "string",
      "enum": [
        "recommendation",
        "deep_research",
        "batch_compare",
        "follow_up"
      ]
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^alice/.+\\.(json|md)$"
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "thesis_request",
        "single_parcel",
        "parcel_group",
        "unresolved_candidate_set",
        "geography_only",
        "batch_subject_set"
      ]
    },
    "resolution_level": {
      "type": "string",
      "enum": [
        "thesis_only",
        "geography_only",
        "listing_identified",
        "address_identified",
        "parcel_candidate_identified",
        "parcel_resolved",
        "parcel_group_resolved",
        "subject_reference_only"
      ]
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "resolved",
        "partially_resolved",
        "unresolved"
      ]
    },
    "high_level_use_case": {
      "type": "string",
      "enum": [
        "energy",
        "agriculture",
        "residential_light_development",
        "industrial_storage_commercial",
        "recreational_rural_hold"
      ]
    },
    "target_geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "state_code",
        "county_fips",
        "county_name"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "active_subject_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "display_label",
        "subject_kind",
        "resolution_level",
        "resolution_status",
        "parcel_candidate_id"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "subject_kind": {
          "$ref": "#/$defs/subject_kind"
        },
        "resolution_level": {
          "$ref": "#/$defs/resolution_level"
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_status"
        },
        "parcel_candidate_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "thesis_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "use_case_hypotheses",
        "target_geographies",
        "filter_notes"
      ],
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "use_case_hypotheses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/high_level_use_case"
          },
          "uniqueItems": true
        },
        "target_geographies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_geography"
          }
        },
        "filter_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_normalized_ref",
        "subject_resolution_ref",
        "parcel_memo_ref",
        "report_ref",
        "report_summary_ref"
      ],
      "properties": {
        "request_normalized_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "subject_resolution_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "parcel_memo_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "report_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "report_summary_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
