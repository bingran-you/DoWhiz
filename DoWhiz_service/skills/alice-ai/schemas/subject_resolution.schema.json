{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/subject_resolution.schema.json",
  "title": "Alice Subject Resolution Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "resolution_id",
    "request_id",
    "request_mode",
    "raw_inputs",
    "normalized_inputs",
    "subject_kind",
    "resolution_status",
    "primary_subject_label",
    "active_subjects",
    "listing_context",
    "parcel_candidates",
    "geography_context",
    "ambiguity_flags",
    "unresolved_questions",
    "next_resolution_actions",
    "scores",
    "citations_or_evidence_refs",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.subject_resolution.v1"
    },
    "resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_mode": {
      "$ref": "#/$defs/request_mode"
    },
    "batch_purpose": {
      "$ref": "#/$defs/batch_purpose"
    },
    "state_refs": {
      "$ref": "#/$defs/state_refs"
    },
    "raw_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raw_input"
      }
    },
    "normalized_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/normalized_input"
      }
    },
    "subject_kind": {
      "$ref": "#/$defs/subject_kind"
    },
    "resolution_status": {
      "$ref": "#/$defs/resolution_status"
    },
    "primary_subject_label": {
      "type": "string",
      "minLength": 1
    },
    "active_subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/active_subject"
      }
    },
    "listing_context": {
      "$ref": "#/$defs/listing_context"
    },
    "parcel_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parcel_candidate"
      }
    },
    "geography_context": {
      "$ref": "#/$defs/geography_context"
    },
    "ambiguity_flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity_flag"
      },
      "uniqueItems": true
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_resolution_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_resolution_action"
      }
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "citations_or_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "recommendation",
        "deep_research",
        "batch_compare",
        "follow_up"
      ]
    },
    "input_kind": {
      "type": "string",
      "enum": [
        "natural_language_intent",
        "listing_url",
        "apn",
        "address",
        "coordinates",
        "subject_ref"
      ]
    },
    "listing_platform": {
      "type": "string",
      "enum": [
        "redfin",
        "zillow",
        "landwatch",
        "land_com",
        "loopnet",
        "broker_site",
        "county_listing",
        "unknown"
      ]
    },
    "coordinate_source": {
      "type": "string",
      "enum": [
        "user_provided",
        "text_extracted",
        "url_query",
        "unknown"
      ]
    },
    "address_parse_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "parsed_components",
        "state_only",
        "city_state_only",
        "freeform",
        null
      ]
    },
    "apn_strategy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "generic_alphanumeric",
        "state_ca_numeric_hyphenated",
        "state_tx_alphanumeric_hyphenated",
        "county_hint_alphanumeric",
        null
      ]
    },
    "coordinates_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^alice/.+\\.(json|md)$"
    },
    "state_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_state_ref",
        "previous_session_state_ref",
        "previous_resolution_ref",
        "previous_report_ref"
      ],
      "properties": {
        "conversation_state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_session_state_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_resolution_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_report_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "raw_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "input_kind",
        "raw_value"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "input_kind": {
          "$ref": "#/$defs/input_kind"
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "normalized_subject_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "$ref": "#/$defs/listing_platform"
        },
        "canonical_url": {
          "type": "string",
          "format": "uri"
        },
        "listing_id": {
          "type": "string",
          "minLength": 1
        },
        "address_like_slug": {
          "type": "string",
          "minLength": 1
        },
        "apn_raw": {
          "type": "string",
          "minLength": 1
        },
        "apn_normalized": {
          "type": "string",
          "minLength": 1
        },
        "apn_strategy": {
          "$ref": "#/$defs/apn_strategy"
        },
        "apn_matching_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "address_text": {
          "type": "string",
          "minLength": 1
        },
        "address_parse_status": {
          "$ref": "#/$defs/address_parse_status"
        },
        "city_hint": {
          "type": "string",
          "minLength": 1
        },
        "state_code_hint": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "county_text_hint": {
          "type": "string",
          "minLength": 1
        },
        "postal_code_hint": {
          "type": "string",
          "pattern": "^[0-9]{5}(?:-[0-9]{4})?$"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinates_value"
        },
        "coordinate_source": {
          "$ref": "#/$defs/coordinate_source"
        },
        "subject_ref_key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resolution_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_fips",
        "state_code",
        "state_name",
        "county_fips",
        "county_name",
        "city_name",
        "source_url"
      ],
      "properties": {
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "city_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "normalized_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "input_kind",
        "raw_value",
        "normalization_status",
        "normalized",
        "resolution_hints",
        "normalization_notes"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "input_kind": {
          "$ref": "#/$defs/input_kind"
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "normalization_status": {
          "type": "string",
          "enum": [
            "normalized",
            "best_effort",
            "invalid"
          ]
        },
        "normalized": {
          "$ref": "#/$defs/normalized_subject_fields"
        },
        "resolution_hints": {
          "$ref": "#/$defs/resolution_hints"
        },
        "normalization_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "thesis_request",
        "single_parcel",
        "parcel_group",
        "unresolved_candidate_set",
        "geography_only",
        "batch_subject_set"
      ]
    },
    "active_subject_kind": {
      "type": "string",
      "enum": [
        "thesis",
        "listing",
        "parcel",
        "parcel_group",
        "address_point",
        "coordinate_point",
        "geography_area",
        "subject_reference"
      ]
    },
    "resolution_level": {
      "type": "string",
      "enum": [
        "thesis_only",
        "geography_only",
        "listing_identified",
        "address_identified",
        "parcel_candidate_identified",
        "parcel_resolved",
        "parcel_group_resolved",
        "subject_reference_only"
      ]
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "resolved",
        "partially_resolved",
        "unresolved"
      ]
    },
    "ambiguity_flag": {
      "type": "string",
      "enum": [
        "county_missing",
        "county_conflict",
        "state_missing",
        "state_conflict",
        "address_needs_geocoding",
        "address_too_broad",
        "coordinates_not_parcel_confirmed",
        "listing_to_parcel_unconfirmed",
        "listing_platform_best_effort",
        "listing_metadata_incomplete",
        "apn_needs_county_context",
        "apn_format_unusual",
        "multi_parcel_possible",
        "parcel_group_possible",
        "batch_mixed_geographies",
        "batch_mixed_resolution_levels",
        "follow_up_reference_ambiguous",
        "no_subject_identifiers",
        "manual_confirmation_required"
      ]
    },
    "identifier_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing_platform",
        "canonical_url",
        "listing_id",
        "address_like_slug",
        "address_text",
        "address_parse_status",
        "apn_raw",
        "apn_normalized",
        "apn_matching_variants",
        "coordinates",
        "county_fips",
        "county_name",
        "state_fips",
        "state_code",
        "state_name",
        "city_name",
        "postal_code",
        "subject_ref_key"
      ],
      "properties": {
        "listing_platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/listing_platform"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "listing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_like_slug": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_parse_status": {
          "$ref": "#/$defs/address_parse_status"
        },
        "apn_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "apn_normalized": {
          "type": [
            "string",
            "null"
          ]
        },
        "apn_matching_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "city_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_ref_key": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "next_resolution_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority",
        "subject_ids",
        "rationale"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "confirm_county_context",
            "confirm_state_context",
            "geocode_address",
            "intersect_coordinates_with_parcel_fabric",
            "query_listing_page",
            "query_parcel_by_apn",
            "split_parcel_group",
            "confirm_follow_up_subject_reference",
            "collect_additional_identifiers",
            "proceed_with_geography_only_research",
            "reuse_prior_resolved_subject",
            "request_user_clarification"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "active_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "input_kind",
        "subject_kind",
        "resolution_level",
        "resolution_status",
        "display_label",
        "identifiers",
        "parcel_candidate_ids",
        "ambiguity_flags",
        "unresolved_questions",
        "next_resolution_actions"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "input_kind": {
          "$ref": "#/$defs/input_kind"
        },
        "subject_kind": {
          "$ref": "#/$defs/active_subject_kind"
        },
        "resolution_level": {
          "$ref": "#/$defs/resolution_level"
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_status"
        },
        "display_label": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "$ref": "#/$defs/identifier_bundle"
        },
        "parcel_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ambiguity_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity_flag"
          },
          "uniqueItems": true
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_resolution_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/next_resolution_action"
          }
        }
      }
    },
    "candidate_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "probable",
        "hinted",
        "rejected"
      ]
    },
    "match_basis": {
      "type": "string",
      "enum": [
        "user_supplied_apn",
        "user_supplied_address",
        "user_supplied_coordinates",
        "listing_url_id",
        "listing_url_slug",
        "listing_url_coordinates",
        "follow_up_reference",
        "conversation_state",
        "thesis_geography",
        "manual_confirmation"
      ]
    },
    "parcel_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "source_subject_ids",
        "candidate_status",
        "label",
        "apn_raw",
        "apn_normalized",
        "county_fips",
        "county_name",
        "state_fips",
        "state_code",
        "state_name",
        "address_text",
        "coordinates",
        "match_basis",
        "confidence",
        "notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "source_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidate_status": {
          "$ref": "#/$defs/candidate_status"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "apn_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "apn_normalized": {
          "type": [
            "string",
            "null"
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "match_basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/match_basis"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_fips",
        "state_code",
        "state_name"
      ],
      "properties": {
        "state_fips": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "state_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "state_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "county_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "county_fips",
        "county_name",
        "state_fips",
        "state_code",
        "state_name"
      ],
      "properties": {
        "county_fips": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "county_name": {
          "type": "string",
          "minLength": 1
        },
        "state_fips": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "state_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "state_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "geography_scope_status": {
      "type": "string",
      "enum": [
        "none",
        "region_scoped",
        "state_scoped",
        "county_scoped",
        "multi_county",
        "point_scoped",
        "mixed"
      ]
    },
    "geography_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_status",
        "states",
        "counties",
        "cities",
        "region_labels",
        "centroid_coordinates",
        "notes"
      ],
      "properties": {
        "scope_status": {
          "$ref": "#/$defs/geography_scope_status"
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_ref"
          }
        },
        "counties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/county_ref"
          }
        },
        "cities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "region_labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "centroid_coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "listing_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_listing_inputs",
        "listing_subject_ids",
        "platforms",
        "canonical_urls",
        "extracted_listing_ids",
        "address_like_slugs",
        "listing_count",
        "notes"
      ],
      "properties": {
        "has_listing_inputs": {
          "type": "boolean"
        },
        "listing_subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listing_platform"
          },
          "uniqueItems": true
        },
        "canonical_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "extracted_listing_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "address_like_slugs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "listing_count": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "batch_purpose": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "compare_candidates",
        "rank_user_supplied_list",
        "light_screen_batch",
        "thesis_search_setup",
        "follow_up_refinement",
        null
      ]
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_confidence",
        "subject_specificity",
        "geography_specificity",
        "batch_readiness"
      ],
      "properties": {
        "resolution_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "subject_specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "geography_specificity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "batch_readiness": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
