{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/extracted_evidence.schema.json",
  "title": "Alice Extracted Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extracted_evidence_id",
    "request_id",
    "subject_resolution_id",
    "fetch_log_id",
    "generated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.extracted_evidence.v1"
    },
    "extracted_evidence_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "fetch_log_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extracted_item"
      }
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "generic_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "estimated",
        "conflicting",
        "missing",
        "not_applicable"
      ]
    },
    "evidence_scope": {
      "type": "string",
      "enum": [
        "parcel_confirmed",
        "parcel_candidate",
        "listing_derived",
        "county_level",
        "geography_only",
        "inferred",
        "unresolved"
      ]
    },
    "clue_type": {
      "type": "string",
      "enum": [
        "apn",
        "county_parcel_id",
        "address",
        "acreage",
        "owner_name",
        "legal_description",
        "county_name",
        "state_name",
        "coordinates",
        "zoning_reference",
        "parcel_group_hint",
        "listing_identifier",
        "page_context",
        "environmental_signal",
        "market_signal",
        "utility_signal",
        "other"
      ]
    },
    "value_type": {
      "type": "string",
      "enum": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "null"
      ]
    },
    "planning_capability": {
      "type": "string",
      "enum": [
        "parcel_identity",
        "parcel_geometry",
        "zoning",
        "planning_docs",
        "tax_roll",
        "environmental_baseline",
        "water_signals",
        "utilities",
        "transmission",
        "market_context"
      ]
    },
    "section_hint": {
      "type": "string",
      "enum": [
        "request_context",
        "subject",
        "listing",
        "jurisdiction",
        "parcel_identity",
        "planning_and_land_use",
        "environmental_constraints",
        "water_and_agriculture",
        "infrastructure_and_utilities",
        "market_signals",
        "risks",
        "unknowns",
        "next_actions"
      ]
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "parsed",
        "derived",
        "conflicting",
        "empty",
        "ignored"
      ]
    },
    "date_like": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "citation_id_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extracted_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "fetch_entry_id",
        "source_id",
        "subject_ids",
        "capability",
        "section_hint",
        "field_name",
        "extraction_status",
        "value",
        "value_type",
        "status",
        "confidence",
        "evidence_scope",
        "clue_type",
        "citation_ids",
        "observed_at",
        "evidence_ref",
        "notes"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[a-z0-9_:-]+$"
        },
        "fetch_entry_id": {
          "$ref": "#/$defs/uuid_string"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capability": {
          "$ref": "#/$defs/planning_capability"
        },
        "section_hint": {
          "$ref": "#/$defs/section_hint"
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "extraction_status": {
          "$ref": "#/$defs/extraction_status"
        },
        "value": {
          "$ref": "#/$defs/generic_value"
        },
        "value_type": {
          "$ref": "#/$defs/value_type"
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_scope": {
          "$ref": "#/$defs/evidence_scope"
        },
        "clue_type": {
          "$ref": "#/$defs/clue_type"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "observed_at": {
          "$ref": "#/$defs/date_like"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
