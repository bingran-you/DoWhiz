{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/alice_land_research.schema.json",
  "title": "Alice Land Research Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "report_type",
    "created_at",
    "request_context",
    "subject",
    "listing",
    "source_urls",
    "jurisdiction",
    "parcel_identity",
    "planning_and_land_use",
    "environmental_constraints",
    "water_and_agriculture",
    "infrastructure_and_utilities",
    "market_signals",
    "use_case_modules",
    "directional_economics",
    "risks",
    "unknowns",
    "next_actions",
    "citations",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.land_research.v1"
    },
    "object_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "report_type": {
      "$ref": "#/$defs/report_type"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_context": {
      "$ref": "#/$defs/request_context"
    },
    "subject": {
      "$ref": "#/$defs/subject_context"
    },
    "listing": {
      "$ref": "#/$defs/listing_metadata"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_url"
      }
    },
    "jurisdiction": {
      "$ref": "#/$defs/jurisdiction"
    },
    "parcel_identity": {
      "$ref": "#/$defs/parcel_identity"
    },
    "planning_and_land_use": {
      "$ref": "#/$defs/planning_and_land_use"
    },
    "environmental_constraints": {
      "$ref": "#/$defs/environmental_constraints"
    },
    "water_and_agriculture": {
      "$ref": "#/$defs/water_and_agriculture"
    },
    "infrastructure_and_utilities": {
      "$ref": "#/$defs/infrastructure_and_utilities"
    },
    "market_signals": {
      "$ref": "#/$defs/market_signals"
    },
    "use_case_modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/use_case_module"
      }
    },
    "directional_economics": {
      "$ref": "#/$defs/directional_economics"
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "scores": {
      "$ref": "#/$defs/scores"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "research_unit_type": {
                "const": "single_parcel"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "parcel_count": {
                "const": 1
              }
            }
          },
          "parcel_identity": {
            "type": "object",
            "properties": {
              "parcels": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "research_unit_type": {
                "const": "parcel_group"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "parcel_count": {
                "type": "integer",
                "minimum": 2
              }
            }
          },
          "parcel_identity": {
            "type": "object",
            "properties": {
              "parcels": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "bounded_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "date_like": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "generic_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        },
        {
          "type": "null"
        }
      ]
    },
    "citation_id_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "slack",
        "discord",
        "sms",
        "telegram",
        "whatsapp",
        "google_docs",
        "google_sheets",
        "google_slides",
        "bluebubbles",
        "notion",
        "wechat",
        "wechat_mp",
        "lark",
        "zoom"
      ]
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "recommendation",
        "deep_research",
        "batch_compare",
        "follow_up"
      ]
    },
    "high_level_use_case": {
      "type": "string",
      "enum": [
        "energy",
        "agriculture",
        "residential_light_development",
        "industrial_storage_commercial",
        "recreational_rural_hold"
      ]
    },
    "coverage_tier": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "minimal"
      ]
    },
    "report_type": {
      "type": "string",
      "enum": [
        "recommendation_candidate",
        "deep_research",
        "batch_compare_item"
      ]
    },
    "research_unit_type": {
      "type": "string",
      "enum": [
        "single_parcel",
        "parcel_group",
        "unresolved_candidate_set"
      ]
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "resolved",
        "partially_resolved",
        "unresolved"
      ]
    },
    "listing_platform": {
      "type": "string",
      "enum": [
        "redfin",
        "zillow",
        "landwatch",
        "land_com",
        "loopnet",
        "broker_site",
        "county_listing",
        "unknown"
      ]
    },
    "source_category": {
      "type": "string",
      "enum": [
        "federal",
        "state",
        "county",
        "city_local",
        "listing_platform",
        "infrastructure_utility_market"
      ]
    },
    "interface_type": {
      "type": "string",
      "enum": [
        "formal_api",
        "gis_service",
        "downloadable_dataset",
        "web_only"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "estimated",
        "conflicting",
        "missing",
        "not_applicable"
      ]
    },
    "risk_severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "risk_category": {
      "type": "string",
      "enum": [
        "zoning",
        "environmental",
        "utilities",
        "market",
        "identity",
        "legal_unknown",
        "water",
        "infrastructure",
        "access"
      ]
    },
    "fit_assessment": {
      "type": "string",
      "enum": [
        "favorable",
        "mixed",
        "weak",
        "not_applicable",
        "unknown"
      ]
    },
    "economics_status": {
      "type": "string",
      "enum": [
        "available",
        "limited",
        "not_enough_data"
      ]
    },
    "assumption_source": {
      "type": "string",
      "enum": [
        "user_assumption",
        "market_proxy",
        "public_record",
        "listing_source",
        "derived_inference"
      ]
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "sold",
        "off_market",
        "unknown"
      ]
    },
    "coordinates_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "address_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_address",
        "country_code"
      ],
      "properties": {
        "full_address": {
          "type": "string",
          "minLength": 1
        },
        "street_line1": {
          "$ref": "#/$defs/nullable_string"
        },
        "street_line2": {
          "$ref": "#/$defs/nullable_string"
        },
        "city": {
          "$ref": "#/$defs/nullable_string"
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "postal_code": {
          "$ref": "#/$defs/nullable_string"
        },
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "evidence_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "citation_ids",
        "as_of",
        "notes"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/generic_value"
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "as_of": {
          "$ref": "#/$defs/date_like"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "address_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "citation_ids",
        "as_of",
        "notes"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/address_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "as_of": {
          "$ref": "#/$defs/date_like"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "coordinates_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "citation_ids",
        "as_of",
        "notes"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "as_of": {
          "$ref": "#/$defs/date_like"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "platform_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "citation_ids",
        "as_of",
        "notes"
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/listing_platform"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "as_of": {
          "$ref": "#/$defs/date_like"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "source_url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "source_id"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fips"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fips": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        }
      }
    },
    "county_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fips"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fips": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        }
      }
    },
    "geography_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "nationwide",
            "state",
            "county",
            "region",
            "city",
            "coordinates_radius"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "city_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "center_coordinates": {
          "anyOf": [
            {
              "$ref": "#/$defs/coordinates_value"
            },
            {
              "type": "null"
            }
          ]
        },
        "radius_miles": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "request_filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acreage_min": {
          "type": "number",
          "minimum": 0
        },
        "acreage_max": {
          "type": "number",
          "minimum": 0
        },
        "min_price": {
          "type": "number",
          "minimum": 0
        },
        "max_price": {
          "type": "number",
          "minimum": 0
        },
        "min_price_per_acre": {
          "type": "number",
          "minimum": 0
        },
        "max_price_per_acre": {
          "type": "number",
          "minimum": 0
        },
        "county_fips": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "uniqueItems": true
        },
        "county_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "uniqueItems": true
        },
        "exclude_major_floodplain": {
          "type": "boolean"
        },
        "prefer_transmission_proximity": {
          "type": "boolean"
        },
        "require_paved_access": {
          "type": "boolean"
        },
        "require_legal_access": {
          "type": "boolean"
        },
        "desired_coverage_tiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_tier"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "request_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "USD"
          ]
        },
        "min_purchase_price": {
          "type": "number",
          "minimum": 0
        },
        "max_purchase_price": {
          "type": "number",
          "minimum": 0
        },
        "target_price_per_acre_min": {
          "type": "number",
          "minimum": 0
        },
        "target_price_per_acre_max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "request_hold_period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_years": {
          "type": "number",
          "minimum": 0
        },
        "max_years": {
          "type": "number",
          "minimum": 0
        },
        "target_strategy": {
          "type": "string",
          "enum": [
            "hold",
            "flip",
            "develop",
            "lease",
            "farm",
            "conservation",
            "mixed",
            "unknown"
          ]
        }
      }
    },
    "request_return_preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_exit_strategies": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hold",
              "flip",
              "develop",
              "ground_lease",
              "farm",
              "lease_to_operator",
              "sell_entitled",
              "conservation_sale",
              "unknown"
            ]
          },
          "uniqueItems": true
        },
        "min_target_multiple": {
          "type": "number",
          "minimum": 0
        },
        "max_payback_years": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "request_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_geographies",
        "filters",
        "budget",
        "hold_period",
        "return_preferences"
      ],
      "properties": {
        "target_geographies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/geography_constraint"
          }
        },
        "filters": {
          "$ref": "#/$defs/request_filters"
        },
        "budget": {
          "$ref": "#/$defs/request_budget"
        },
        "hold_period": {
          "$ref": "#/$defs/request_hold_period"
        },
        "return_preferences": {
          "$ref": "#/$defs/request_return_preferences"
        }
      }
    },
    "subject_input_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_kind",
        "raw_value"
      ],
      "properties": {
        "input_kind": {
          "type": "string",
          "enum": [
            "listing_url",
            "apn",
            "address",
            "coordinates",
            "batch_item",
            "subject_ref"
          ]
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "signal_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "status",
        "confidence",
        "citation_ids",
        "as_of",
        "notes"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        },
        "as_of": {
          "$ref": "#/$defs/date_like"
        },
        "notes": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "conflict_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_name",
        "description",
        "citation_ids"
      ],
      "properties": {
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "citation_ids": {
          "$ref": "#/$defs/citation_id_array"
        }
      }
    },
    "nearby_listing_context_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "asking_price",
        "acreage",
        "citation_ids",
        "notes"
      ],
      "properties": {
        "label": {
