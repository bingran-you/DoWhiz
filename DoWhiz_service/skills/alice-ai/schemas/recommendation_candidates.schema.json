{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/recommendation_candidates.schema.json",
  "title": "Alice Recommendation Candidate Universe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_candidates_id",
    "request_id",
    "subject_resolution_id",
    "generated_at",
    "request_mode",
    "thesis_summary",
    "search_scope",
    "acquisition_summary",
    "candidate_count",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.recommendation_candidates.v1"
    },
    "recommendation_candidates_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_mode": {
      "$ref": "#/$defs/recommendation_request_mode"
    },
    "thesis_summary": {
      "type": "string",
      "minLength": 1
    },
    "search_scope": {
      "$ref": "#/$defs/search_scope"
    },
    "acquisition_summary": {
      "$ref": "#/$defs/acquisition_summary"
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "positive_number_or_null": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "listing_platform": {
      "type": "string",
      "enum": [
        "redfin",
        "zillow",
        "landwatch",
        "land_com",
        "loopnet",
        "broker_site",
        "county_listing",
        "unknown"
      ]
    },
    "recommendation_request_mode": {
      "type": "string",
      "enum": [
        "user_supplied_ranking",
        "open_discovery",
        "prior_set_refinement"
      ]
    },
    "acquisition_path": {
      "type": "string",
      "enum": [
        "user_supplied_listing_url",
        "open_discovery_catalog",
        "prior_recommendation_artifact",
        "prior_workspace_artifact"
      ]
    },
    "initial_eligibility_status": {
      "type": "string",
      "enum": [
        "eligible",
        "soft_filtered",
        "hard_filtered",
        "needs_review",
        "duplicate_collapsed"
      ]
    },
    "candidate_observation_status": {
      "type": "string",
      "enum": [
        "observed_with_research_artifacts",
        "observed_listing_only",
        "unsupported"
      ]
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "nationwide",
            "state",
            "county",
            "region",
            "city",
            "coordinates_radius"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "city_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "radius_miles": {
          "$ref": "#/$defs/positive_number_or_null"
        }
      }
    },
    "request_filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acreage_min": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "acreage_max": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "min_price": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "max_price": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "min_price_per_acre": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "max_price_per_acre": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "exclude_major_floodplain": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "prefer_transmission_proximity": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "require_paved_access": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "require_legal_access": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "desired_coverage_tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "minimal",
              "partial",
              "full"
            ]
          },
          "uniqueItems": true
        },
        "notes": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_geographies",
        "filters",
        "budget_max_purchase_price",
        "active_use_case_hypotheses",
        "notes"
      ],
      "properties": {
        "target_geographies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_geography"
          }
        },
        "filters": {
          "$ref": "#/$defs/request_filters"
        },
        "budget_max_purchase_price": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "active_use_case_hypotheses": {
          "$ref": "#/$defs/string_array"
        },
        "notes": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "acquisition_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_platforms",
        "input_subject_count",
        "duplicate_input_count",
        "matched_existing_research_count",
        "unmatched_input_count",
        "candidate_observation_limitations",
        "acquisition_notes"
      ],
      "properties": {
        "observed_platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listing_platform"
          },
          "uniqueItems": true
        },
        "input_subject_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_input_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_existing_research_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmatched_input_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_observation_limitations": {
          "$ref": "#/$defs/string_array"
        },
        "acquisition_notes": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "raw_listing_hints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "asking_price",
        "acreage",
        "county_name",
        "state_code",
        "county_fips",
        "listing_id",
        "listing_text_summary"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nullable_string"
        },
        "asking_price": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "acreage": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "listing_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "listing_text_summary": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "normalized_subject_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_kind",
        "raw_value",
        "canonical_url",
        "listing_platform",
        "listing_id",
        "county_fips",
        "county_name",
        "state_fips",
        "state_code",
        "state_name"
      ],
      "properties": {
        "input_kind": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "$ref": "#/$defs/nullable_string"
        },
        "listing_platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/listing_platform"
            },
            {
              "type": "null"
            }
          ]
        },
        "listing_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "linked_workspace_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_root",
        "parcel_memo_ref",
        "coverage_assessment_ref",
        "parcel_candidates_ref",
        "report_ref"
      ],
      "properties": {
        "workspace_root": {
          "$ref": "#/$defs/artifact_path"
        },
        "parcel_memo_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "coverage_assessment_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "parcel_candidates_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "report_ref": {
          "$ref": "#/$defs/artifact_path"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_subject_id",
        "source_listing_url",
        "platform",
        "acquisition_path",
        "candidate_observation_status",
        "raw_listing_hints",
        "normalized_subject_seed",
        "dedupe_group_id",
        "initial_match_rationale",
        "initial_eligibility_status",
        "notes"
      ],
      "properties": {
        "candidate_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "source_listing_url": {
          "$ref": "#/$defs/nullable_string"
        },
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/listing_platform"
            },
            {
              "type": "null"
            }
          ]
        },
        "acquisition_path": {
          "$ref": "#/$defs/acquisition_path"
        },
        "candidate_observation_status": {
          "$ref": "#/$defs/candidate_observation_status"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "raw_listing_hints": {
          "$ref": "#/$defs/raw_listing_hints"
        },
        "normalized_subject_seed": {
          "$ref": "#/$defs/normalized_subject_seed"
        },
        "dedupe_group_id": {
          "type": "string",
          "minLength": 1
        },
        "initial_match_rationale": {
          "type": "string",
          "minLength": 1
        },
        "initial_eligibility_status": {
          "$ref": "#/$defs/initial_eligibility_status"
        },
        "linked_workspace_artifacts": {
          "anyOf": [
            {
              "$ref": "#/$defs/linked_workspace_artifacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "$ref": "#/$defs/string_array"
        }
      }
    }
  }
}
