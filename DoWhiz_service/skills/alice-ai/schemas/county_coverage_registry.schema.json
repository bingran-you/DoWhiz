{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/county_coverage_registry.schema.json",
  "title": "Alice County Coverage Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "county_fips",
    "state_fips",
    "county_name",
    "registry_version",
    "coverage_tier",
    "capabilities",
    "preferred_source_ids",
    "discovered_source_ids",
    "known_limitations",
    "last_verified_at"
  ],
  "properties": {
    "county_fips": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "state_fips": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "county_name": {
      "type": "string",
      "minLength": 1
    },
    "registry_version": {
      "const": "alice.county_coverage_registry.v1"
    },
    "coverage_tier": {
      "$ref": "#/$defs/coverage_tier"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parcel_identity",
        "zoning",
        "planning_docs",
        "tax_roll",
        "utilities"
      ],
      "properties": {
        "parcel_identity": {
          "$ref": "#/$defs/capability_level"
        },
        "zoning": {
          "$ref": "#/$defs/capability_level"
        },
        "planning_docs": {
          "$ref": "#/$defs/capability_level"
        },
        "tax_roll": {
          "$ref": "#/$defs/capability_level"
        },
        "utilities": {
          "$ref": "#/$defs/capability_level"
        },
        "environmental": {
          "$ref": "#/$defs/capability_level"
        },
        "water": {
          "$ref": "#/$defs/capability_level"
        },
        "transmission": {
          "$ref": "#/$defs/capability_level"
        },
        "broadband": {
          "$ref": "#/$defs/capability_level"
        },
        "listings": {
          "$ref": "#/$defs/capability_level"
        }
      }
    },
    "preferred_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "discovered_source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "coverage_tier": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "minimal"
      ]
    },
    "capability_level": {
      "type": "string",
      "enum": [
        "full",
        "partial",
        "minimal",
        "none"
      ]
    }
  }
}
