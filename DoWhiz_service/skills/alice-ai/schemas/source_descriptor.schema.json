{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/source_descriptor.schema.json",
  "title": "Alice Source Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "name",
    "category",
    "jurisdiction_level",
    "geography_scope",
    "interface_type",
    "access_mode",
    "capabilities",
    "base_url",
    "priority",
    "authority_rank",
    "ttl_hours",
    "auth_required",
    "status",
    "last_verified_at",
    "notes"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "$ref": "#/$defs/source_category"
    },
    "jurisdiction_level": {
      "$ref": "#/$defs/jurisdiction_level"
    },
    "geography_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "national",
        "state_fips",
        "county_fips",
        "city_name",
        "special_district_name",
        "notes"
      ],
      "properties": {
        "national": {
          "type": "boolean"
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "city_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "special_district_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "interface_type": {
      "$ref": "#/$defs/interface_type"
    },
    "access_mode": {
      "$ref": "#/$defs/access_mode"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_capability"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "authority_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "ttl_hours": {
      "type": "integer",
      "minimum": 0
    },
    "auth_required": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/source_status"
    },
    "last_verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "source_category": {
      "type": "string",
      "enum": [
        "federal",
        "state",
        "county",
        "city_local",
        "listing_platform",
        "infrastructure_utility_market"
      ]
    },
    "jurisdiction_level": {
      "type": "string",
      "enum": [
        "federal",
        "state",
        "county",
        "city",
        "special_district",
        "multi_jurisdiction",
        "platform"
      ]
    },
    "interface_type": {
      "type": "string",
      "enum": [
        "formal_api",
        "gis_service",
        "downloadable_dataset",
        "web_only"
      ]
    },
    "source_status": {
      "type": "string",
      "enum": [
        "active",
        "degraded",
        "offline",
        "manual_review"
      ]
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "machine_endpoint",
        "landing_page",
        "viewer",
        "mixed"
      ]
    },
    "source_capability": {
      "type": "string",
      "enum": [
        "parcel_lookup_by_apn",
        "parcel_lookup_by_address",
        "parcel_geometry",
        "owner_name",
        "site_address",
        "zoning",
        "future_land_use",
        "development_code",
        "tax_roll",
        "flood",
        "wetlands",
        "soil",
        "topography_elevation",
        "environmental_screening",
        "water_rights",
        "utility_territory",
        "transmission",
        "broadband",
        "listing_search",
        "market_context"
      ]
    }
  }
}
