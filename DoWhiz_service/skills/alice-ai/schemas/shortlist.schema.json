{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/shortlist.schema.json",
  "title": "Alice Recommendation Shortlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "shortlist_id",
    "request_id",
    "subject_resolution_id",
    "recommendation_candidates_id",
    "generated_at",
    "ranking_basis",
    "shortlist_summary",
    "candidate_universe_limits",
    "ranked_items",
    "filtered_out_items",
    "warnings",
    "source_coverage_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.shortlist.v1"
    },
    "shortlist_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "recommendation_candidates_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ranking_basis": {
      "$ref": "#/$defs/ranking_basis"
    },
    "shortlist_summary": {
      "$ref": "#/$defs/shortlist_summary"
    },
    "candidate_universe_limits": {
      "$ref": "#/$defs/candidate_universe_limits"
    },
    "ranked_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ranked_item"
      }
    },
    "filtered_out_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filtered_out_item"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning_item"
      }
    },
    "source_coverage_notes": {
      "$ref": "#/$defs/string_array"
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "bounded_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "positive_number_or_null": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "user_supplied_ranking",
        "open_discovery",
        "prior_set_refinement"
      ]
    },
    "listing_platform": {
      "type": "string",
      "enum": [
        "redfin",
        "zillow",
        "landwatch",
        "land_com",
        "loopnet",
        "broker_site",
        "county_listing",
        "unknown"
      ]
    },
    "fit_assessment": {
      "type": "string",
      "enum": [
        "favorable",
        "mixed",
        "weak",
        "unknown",
        "not_applicable"
      ]
    },
    "module_status": {
      "type": "string",
      "enum": [
        "evaluated",
        "partially_evaluated",
        "insufficient_data",
        "blocked"
      ]
    },
    "coverage_tier": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "minimal",
        "partial",
        "full",
        null
      ]
    },
    "local_footing_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "deep_research_ready",
        "partially_ready",
        "not_ready",
        "strong_local_footing",
        "partial_local_footing",
        "federal_baseline_only",
        "minimal_local_footing",
        null
      ]
    },
    "parcel_identity_level": {
      "type": "string",
      "enum": [
        "parcel_confirmed",
        "candidate_corroborated",
        "candidate_unconfirmed",
        "listing_hint_only",
        "geography_only",
        "unresolved"
      ]
    },
    "factor_type": {
      "type": "string",
      "enum": [
        "module_fit",
        "budget_match",
        "acreage_match",
        "geography_match",
        "parcel_identity",
        "evidence_quality",
        "coverage_footing",
        "directional_economics",
        "blocker_burden",
        "unknown_burden",
        "transmission_preference",
        "flood_burden",
        "access_requirement",
        "candidate_universe_limit"
      ]
    },
    "factor_effect": {
      "type": "string",
      "enum": [
        "strong_positive",
        "positive",
        "neutral",
        "negative",
        "hard_filter"
      ]
    },
    "warning_type": {
      "type": "string",
      "enum": [
        "thin_candidate_universe",
        "non_exhaustive_market_coverage",
        "duplicate_inputs_collapsed",
        "unmatched_user_candidates",
        "hard_filtered_candidates_present",
        "mixed_evidence_rankings"
      ]
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "linked_workspace_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_root",
        "parcel_memo_ref",
        "coverage_assessment_ref",
        "parcel_candidates_ref",
        "report_ref"
      ],
      "properties": {
        "workspace_root": {
          "$ref": "#/$defs/artifact_path"
        },
        "parcel_memo_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "coverage_assessment_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "parcel_candidates_ref": {
          "$ref": "#/$defs/artifact_path"
        },
        "report_ref": {
          "$ref": "#/$defs/artifact_path"
        }
      }
    },
    "geography_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "county_name",
        "state_code",
        "state_name",
        "city_or_place"
      ],
      "properties": {
        "county_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "$ref": "#/$defs/nullable_string"
        },
        "city_or_place": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "module_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_id",
        "module_label",
        "fit_assessment",
        "module_status",
        "confidence"
      ],
      "properties": {
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "module_label": {
          "type": "string",
          "minLength": 1
        },
        "fit_assessment": {
          "$ref": "#/$defs/fit_assessment"
        },
        "module_status": {
          "$ref": "#/$defs/module_status"
        },
        "confidence": {
          "$ref": "#/$defs/bounded_score"
        }
      }
    },
    "fit_assessment_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_fit",
        "summary",
        "module_outcomes"
      ],
      "properties": {
        "overall_fit": {
          "$ref": "#/$defs/fit_assessment"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "module_outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module_outcome"
          }
        }
      }
    },
    "ranking_factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_type",
        "effect",
        "rationale"
      ],
      "properties": {
        "factor_type": {
          "$ref": "#/$defs/factor_type"
        },
        "effect": {
          "$ref": "#/$defs/factor_effect"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_confidence",
        "overall_completeness",
        "coverage_tier",
        "local_footing_status",
        "parcel_identity_level"
      ],
      "properties": {
        "overall_confidence": {
          "$ref": "#/$defs/bounded_score"
        },
        "overall_completeness": {
          "$ref": "#/$defs/bounded_score"
        },
        "coverage_tier": {
          "$ref": "#/$defs/coverage_tier"
        },
        "local_footing_status": {
          "$ref": "#/$defs/local_footing_status"
        },
        "parcel_identity_level": {
          "$ref": "#/$defs/parcel_identity_level"
        }
      }
    },
    "ranked_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "candidate_subject_id",
        "primary_label",
        "source_listing_url",
        "platform",
        "geography",
        "asking_price",
        "acreage",
        "fit_assessment_summary",
        "active_module_ids",
        "ranking_factors",
        "major_blockers",
        "major_unknowns",
        "evidence_quality_summary",
        "candidate_universe_positioning_note",
        "linked_workspace_artifacts"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_label": {
          "type": "string",
          "minLength": 1
        },
        "source_listing_url": {
          "$ref": "#/$defs/nullable_string"
        },
        "platform": {
          "anyOf": [
            {
              "$ref": "#/$defs/listing_platform"
            },
            {
              "type": "null"
            }
          ]
        },
        "geography": {
          "$ref": "#/$defs/geography_summary"
        },
        "asking_price": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "acreage": {
          "$ref": "#/$defs/positive_number_or_null"
        },
        "fit_assessment_summary": {
          "$ref": "#/$defs/fit_assessment_summary"
        },
        "active_module_ids": {
          "$ref": "#/$defs/string_array"
        },
        "ranking_factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ranking_factor"
          }
        },
        "major_blockers": {
          "$ref": "#/$defs/string_array"
        },
        "major_unknowns": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_quality_summary": {
          "$ref": "#/$defs/evidence_quality_summary"
        },
        "candidate_universe_positioning_note": {
          "type": "string",
          "minLength": 1
        },
        "linked_workspace_artifacts": {
          "$ref": "#/$defs/linked_workspace_artifacts"
        }
      }
    },
    "filtered_out_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_subject_id",
        "primary_label",
        "source_listing_url",
        "filter_reason",
        "major_blockers",
        "major_unknowns",
        "notes"
      ],
      "properties": {
        "candidate_subject_id": {
          "type": "string",
          "minLength": 1
        },
        "primary_label": {
          "type": "string",
          "minLength": 1
        },
        "source_listing_url": {
          "$ref": "#/$defs/nullable_string"
        },
        "filter_reason": {
          "type": "string",
          "minLength": 1
        },
        "major_blockers": {
          "$ref": "#/$defs/string_array"
        },
        "major_unknowns": {
          "$ref": "#/$defs/string_array"
        },
        "notes": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "warning_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_type",
        "message"
      ],
      "properties": {
        "warning_type": {
          "$ref": "#/$defs/warning_type"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ranking_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_mode",
        "active_module_ids",
        "ranking_policy_notes",
        "applied_filters"
      ],
      "properties": {
        "request_mode": {
          "$ref": "#/$defs/request_mode"
        },
        "active_module_ids": {
          "$ref": "#/$defs/string_array"
        },
        "ranking_policy_notes": {
          "$ref": "#/$defs/string_array"
        },
        "applied_filters": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "shortlist_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_count",
        "filtered_out_count",
        "top_pick_candidate_subject_id",
        "top_pick_label",
        "one_line_summary",
        "limitation_note"
      ],
      "properties": {
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_out_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_pick_candidate_subject_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "top_pick_label": {
          "$ref": "#/$defs/nullable_string"
        },
        "one_line_summary": {
          "type": "string",
          "minLength": 1
        },
        "limitation_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_universe_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_candidate_count",
        "eligible_candidate_count",
        "ranked_candidate_count",
        "filtered_candidate_count",
        "observed_platforms",
        "exhaustive_market_scan",
        "limitation_note"
      ],
      "properties": {
        "observed_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "ranked_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed_platforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listing_platform"
          },
          "uniqueItems": true
        },
        "exhaustive_market_scan": {
          "const": false
        },
        "limitation_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
