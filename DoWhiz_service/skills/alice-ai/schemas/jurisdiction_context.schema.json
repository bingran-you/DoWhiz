{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dowhiz.com/schemas/alice/jurisdiction_context.schema.json",
  "title": "Alice Jurisdiction Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdiction_context_id",
    "request_id",
    "subject_resolution_id",
    "session_state_ref",
    "request_mode",
    "active_subject_ids",
    "subject_jurisdictions",
    "geography_status",
    "state",
    "county",
    "city_or_place",
    "incorporated_status",
    "county_fips",
    "state_fips",
    "state_code",
    "derivation_sources",
    "jurisdiction_conflicts",
    "special_district_placeholders",
    "effective_county_registry_ref",
    "effective_county_registry_mode",
    "unresolved_questions",
    "notes",
    "scores",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "alice.jurisdiction_context.v1"
    },
    "jurisdiction_context_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "request_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "subject_resolution_id": {
      "$ref": "#/$defs/uuid_string"
    },
    "session_state_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/artifact_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_mode": {
      "$ref": "#/$defs/request_mode"
    },
    "active_subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "subject_jurisdictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject_jurisdiction"
      }
    },
    "geography_status": {
      "$ref": "#/$defs/geography_status"
    },
    "state": {
      "$ref": "#/$defs/state_context"
    },
    "county": {
      "$ref": "#/$defs/county_context"
    },
    "city_or_place": {
      "$ref": "#/$defs/city_context"
    },
    "incorporated_status": {
      "$ref": "#/$defs/incorporated_status"
    },
    "county_fips": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_fips": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_code": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "derivation_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/derivation_source"
      }
    },
    "jurisdiction_conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jurisdiction_conflict"
      }
    },
    "special_district_placeholders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/special_district_placeholder"
      }
    },
    "effective_county_registry_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/registry_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_county_registry_mode": {
      "$ref": "#/$defs/effective_county_registry_mode"
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scores": {
      "$ref": "#/$defs/scores"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "uuid_string": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "artifact_ref": {
      "type": "string",
      "pattern": "^alice/.+\\.(json|md)$"
    },
    "registry_ref": {
      "type": "string",
      "pattern": "^(registry/.+\\.json|generated:county_fallback:[0-9]{5})$"
    },
    "effective_county_registry_mode": {
      "type": "string",
      "enum": [
        "curated_override",
        "generated_fallback",
        "none"
      ]
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "recommendation",
        "deep_research",
        "batch_compare",
        "follow_up"
      ]
    },
    "geography_status": {
      "type": "string",
      "enum": [
        "county_resolved",
        "county_inferred",
        "state_resolved",
        "city_state_partial",
        "geography_only",
        "mixed_subjects",
        "conflicted",
        "unresolved"
      ]
    },
    "resolution_state": {
      "type": "string",
      "enum": [
        "resolved",
        "candidate",
        "unresolved",
        "conflicted"
      ]
    },
    "incorporated_status": {
      "type": "string",
      "enum": [
        "incorporated",
        "unincorporated",
        "unknown",
        "mixed"
      ]
    },
    "derivation_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "explicit_request_geography_fips",
        "explicit_request_geography_text",
        "explicit_subject_hint",
        "inherited_session_state",
        "subject_resolution_hint",
        "address_parse_hint",
        "listing_url_slug_hint",
        "geography_context_rollup",
        null
      ]
    },
    "derivation_scope": {
      "type": "string",
      "enum": [
        "state",
        "county",
        "city_or_place",
        "incorporated_status"
      ]
    },
    "conflict_type": {
      "type": "string",
      "enum": [
        "state_conflict",
        "county_conflict",
        "city_conflict",
        "session_state_conflict",
        "batch_subject_mismatch"
      ]
    },
    "state_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fips",
        "code",
        "name",
        "resolution_status",
        "derivation_type",
        "subject_ids",
        "notes"
      ],
      "properties": {
        "fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_state"
        },
        "derivation_type": {
          "$ref": "#/$defs/derivation_type"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "county_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fips",
        "name",
        "resolution_status",
        "derivation_type",
        "subject_ids",
        "notes"
      ],
      "properties": {
        "fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_state"
        },
        "derivation_type": {
          "$ref": "#/$defs/derivation_type"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "city_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resolution_status",
        "derivation_type",
        "subject_ids",
        "notes"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_status": {
          "$ref": "#/$defs/resolution_state"
        },
        "derivation_type": {
          "$ref": "#/$defs/derivation_type"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subject_jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "geography_status",
        "state_fips",
        "state_code",
        "state_name",
        "county_fips",
        "county_name",
        "city_or_place",
        "incorporated_status",
        "derivation_types",
        "notes"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "geography_status": {
          "$ref": "#/$defs/geography_status"
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "city_or_place": {
          "type": [
            "string",
            "null"
          ]
        },
        "incorporated_status": {
          "$ref": "#/$defs/incorporated_status"
        },
        "derivation_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivation_type"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derivation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_id",
        "derivation_type",
        "scope",
        "subject_ids",
        "state_fips",
        "state_code",
        "state_name",
        "county_fips",
        "county_name",
        "city_name",
        "source_ref",
        "confidence",
        "notes"
      ],
      "properties": {
        "derivation_id": {
          "type": "string",
          "minLength": 1
        },
        "derivation_type": {
          "$ref": "#/$defs/derivation_type"
        },
        "scope": {
          "$ref": "#/$defs/derivation_scope"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "county_fips": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "county_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "city_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "jurisdiction_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_type",
        "subject_ids",
        "candidate_values",
        "notes"
      ],
      "properties": {
        "conflict_type": {
          "$ref": "#/$defs/conflict_type"
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "candidate_values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "special_district_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "district_type",
        "status",
        "name",
        "source_ids",
        "notes"
      ],
      "properties": {
        "district_type": {
          "type": "string",
          "enum": [
            "appraisal_district",
            "planning_authority",
            "water_district",
            "utility_service_area",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "unknown",
            "deferred"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction_confidence",
        "county_attachment_readiness",
        "subject_alignment_score"
      ],
      "properties": {
        "jurisdiction_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "county_attachment_readiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "subject_alignment_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
