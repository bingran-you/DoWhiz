# Minimal public local profile for DoWhiz_service.
#
# Copy this file to DoWhiz_service/.env and adjust only if your local ports or
# database credentials differ.

DEPLOY_TARGET=local
EMPLOYEE_ID=sticky_octopus

# Keep the minimal public profile local-only by default.
CODEX_DISABLED=1
ROUTER_ENABLED=false
GOOGLE_DOCS_ENABLED=false

RUST_SERVICE_HOST=0.0.0.0
RUST_SERVICE_PORT=9001
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9100

# Local service demos use local databases instead of private cloud services.
STORAGE_BACKEND=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/dowhiz_local?directConnection=true
MONGODB_DATABASE=dowhiz_local

INGESTION_QUEUE_BACKEND=postgres
INGESTION_DB_URL=postgresql://dowhiz:dowhiz@127.0.0.1:5432/dowhiz_local?sslmode=disable
SUPABASE_DB_URL=postgresql://dowhiz:dowhiz@127.0.0.1:5432/dowhiz_local?sslmode=disable
SUPABASE_POOLER_URL=
SUPABASE_PROJECT_URL=http://127.0.0.1:54321

# Local-only archival path for ingress payloads.
RAW_PAYLOAD_STORAGE_BACKEND=local
RAW_PAYLOAD_LOCAL_ROOT=.workspace/local_payloads

# Local demo routes do not require outbound email or live webhook providers.
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_HOOK_URL=

FRONTEND_URL=http://localhost:5173
